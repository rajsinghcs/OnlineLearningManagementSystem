          "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"passwordHash\": \"password123\",\n  \"role\": \"STUDENT\",\n  \"provider\": \"LOCAL\",\n  \"mobile\": 9876543210,\n  \"bio\": \"Computer Science Student\",\n  \"profilePicUrl\": \"https://example.com/avatar.jpg\"\n}"
        },
        "url": {
